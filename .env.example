VITE_API_URL=http://localhost:4000/api/v1
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_APP_NAME=ApexFIT
VITE_USE_MOCK=false
# Public landing SEO. Keep empty/false on preview & staging (noindex, no canonical, no sitemap).
# Production: real https domain + VITE_INDEX_PUBLIC=true, then `npm run build:seo`.
VITE_PUBLIC_SITE_URL=
VITE_INDEX_PUBLIC=false

# Counter bank transfer (VietQR shown on the receipt). BIN = NAPAS bank code, e.g. 970436 Vietcombank.
VITE_BANK_BIN=
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NO=
VITE_BANK_ACCOUNT_NAME=
